<script>
const box = document.querySelector<HTMLElement>(".show")!;
const fit = box.querySelector<HTMLElement>(".fit")!;
const stage = box.querySelector<HTMLElement>(".stage")!;
// The examples are drawn at a fixed size and scaled to the column, so the scattered notes keep their layout.
const resize = () => {
  const w = fit.clientWidth, stacked = w < 900, dw = stacked ? 690 : 1400, dh = stacked ? 1192 : 656;
  const s = Math.min(1, w / dw);
  box.classList.toggle("stacked", stacked);
  stage.style.width = dw + "px";
  stage.style.transform = `scale(${s})`;
  fit.style.height = dh * s + "px";
};
new ResizeObserver(resize).observe(fit);
resize();

const slides = [...box.querySelectorAll(".slide")], tabs = [...box.querySelectorAll<HTMLElement>(".tabs button")];
let i = 0, timer: number | undefined;
const show = (n: number) => {
  i = (n + slides.length) % slides.length;
  slides.forEach((s, k) => s.classList.toggle("on", k === i));
  tabs.forEach((t, k) => t.setAttribute("aria-selected", String(k === i)));
};
const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
const stop = () => clearInterval(timer);
const start = () => { stop(); if (!reduce) timer = setInterval(() => show(i + 1), 7000); };
tabs.forEach((t, k) => t.addEventListener("click", () => { stop(); show(k); }));
box.querySelector("#prev")!.addEventListener("click", () => { stop(); show(i - 1); });
box.querySelector("#next")!.addEventListener("click", () => { stop(); show(i + 1); });
box.addEventListener("keydown", (e) => {
  if (e.key === "ArrowLeft") { stop(); show(i - 1); }
  if (e.key === "ArrowRight") { stop(); show(i + 1); }
});
fit.addEventListener("mouseenter", stop);
fit.addEventListener("mouseleave", start);
start();
</script>
